# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
# Single allowed owner Telegram user id (mandatory; bot won't start without it)
TELEGRAM_ALLOWED_USER_ID=123456789

# Optional HTTP/SOCKS proxy for Telegram API traffic (e.g. when Telegram is
# blocked on the local network). Credentials may be embedded in the URL or given
# separately via the two fields below.
# TELEGRAM_PROXY_URL=http://10.1.252.242:9999
# TELEGRAM_PROXY_USERNAME=a.abramenko
# TELEGRAM_PROXY_PASSWORD=secret

# Kilo server connection (kilocode-client)
KILO_SERVER_URL=http://127.0.0.1:4096
KILO_SERVER_USERNAME=kilo
KILO_SERVER_PASSWORD=

# Optional project directory when the server manages multiple projects
# KILO_SERVER_DIRECTORY=/path/to/project

# Streaming / message behaviour
TELEGRAM_EDIT_THROTTLE_SECONDS=1.0
MESSAGE_FILE_THRESHOLD=3900

# SQLite database path for the active-session store
SESSION_STORE_PATH=kilocode_bot_state.db